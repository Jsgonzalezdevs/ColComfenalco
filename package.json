{
  "name": "inventario-comfenalco",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && tsc -p workers/tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "dev:api": "wrangler dev",
    "deploy:api": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply comfenalco-activos --local",
    "test": "vitest run"
  },
  "dependencies": {
    "docx-preview": "0.4.1",
    "docxtemplater": "^3.71.1",
    "lucide-react": "1.66.0",
    "pizzip": "^3.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261102.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.156.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.25.0"
}
